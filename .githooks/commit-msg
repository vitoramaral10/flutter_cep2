#!/usr/bin/env bash
# Checks the subject line against Conventional Commits.
subject=$(head -n1 "$1")

# Messages git writes itself are fine.
if [[ $subject =~ ^(Merge|Revert|fixup!|squash!) ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'
if ! [[ $subject =~ $pattern ]]; then
  echo "Commit subject does not follow Conventional Commits:"
  echo "  $subject"
  echo
  echo "Expected: type(scope?): subject   e.g. fix: handle malformed XML response"
  echo "Types: feat fix docs style refactor perf test build ci chore revert"
  exit 1
fi
